# Copy to .env and edit:  cp .env.example .env
# docker compose reads .env automatically for ${VAR} substitution.

COMPOSE_PROJECT_NAME=temporal

# --- Versions -----------------------------------------------------------------
# Server and admin-tools always share TEMPORAL_VERSION (see Dockerfile).
# Upgrade one minor version at a time (1.31 -> 1.32 -> 1.33); the setup job
# applies schema migrations on the next `docker compose up`.
TEMPORAL_VERSION=1.32.0
TEMPORAL_UI_VERSION=2.55.0
# Postgres 18+ images moved PGDATA; bumping major versions needs a dump/restore
# and a volume path change. Stay on 16 unless you plan that migration.
POSTGRES_VERSION=16

# --- PostgreSQL -----------------------------------------------------------------
POSTGRES_USER=temporal
# Port Postgres listens on inside the compose network. Temporal, the schema job
# and the healthcheck all read this; it is not published to the host.
POSTGRES_PORT=5432
# CHANGE THIS. Used both to initialise Postgres and by Temporal to connect.
# Changing it after first boot does NOT change the existing DB user's password.
POSTGRES_PASSWORD=change-me

# --- Server -----------------------------------------------------------------
# IMMUTABLE after the first start: cannot be changed without wiping the DB.
# Caps write throughput; 128 is ample for a single VM. Upstream dev default is 4.
NUM_HISTORY_SHARDS=128
LOG_LEVEL=info

DEFAULT_NAMESPACE=default
# Closed-workflow history retention for the default namespace (only applied
# when it is first created; change later with `temporal operator namespace update`).
DEFAULT_NAMESPACE_RETENTION=72h

# --- Published ports ------------------------------------------------------------
# Host interface to publish on. 0.0.0.0 = all interfaces. Set to the VM's
# private IP or 127.0.0.1 to restrict. NOTE: Docker-published ports bypass
# ufw/firewalld INPUT rules; restrict at the cloud firewall / security group.
BIND_ADDRESS=0.0.0.0
TEMPORAL_GRPC_PORT=7233
TEMPORAL_UI_PORT=8080
